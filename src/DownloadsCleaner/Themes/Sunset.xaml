<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Скин «Закат»: те же токены, что в Dark.xaml (DynamicResource), другая палитра. -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="#140D10"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#1A1014"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#21151A"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="#2A1B21"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#1A1115"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#261920"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#3A2730"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#553946"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F8ECEF"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#C9AAB4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8E7179"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#10FFFFFF"/>
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#1CFFFFFF"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#2EFB923C"/>
    <SolidColorBrush x:Key="TextSecondarySoftBrush" Color="#22C9AAB4"/>
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#26181E" Offset="0"/>
        <GradientStop Color="#1B1116" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#2CFFFFFF" Offset="0"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3AF97316" Offset="0"/>
        <GradientStop Color="#22EC4899" Offset="0.6"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrimBrush" Color="#B00C0608"/>

    <Color x:Key="AccentColor">#F97316</Color>
    <Color x:Key="AccentBlueColor">#EC4899</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#F472B6"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#22FB923C"/>
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#22F472B6"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EA580C" Offset="0"/>
        <GradientStop Color="#DB2777" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#2234D399"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FACC15"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#22FACC15"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#22F87171"/>
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
