<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Светлая тема: токены цвета. Все страницы и стили используют только эти ключи (DynamicResource). -->
    <SolidColorBrush x:Key="BgBaseBrush" Color="#F3F4F9"/>
    <SolidColorBrush x:Key="BgSidebarBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="BgCardHoverBrush" Color="#F8F9FD"/>
    <SolidColorBrush x:Key="BgInputBrush" Color="#F0F2F8"/>
    <SolidColorBrush x:Key="BgElevatedBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="StrokeBrush" Color="#E2E5EE"/>
    <SolidColorBrush x:Key="StrokeStrongBrush" Color="#C6CBDA"/>
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#161821"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#50566A"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8A90A3"/>
    <SolidColorBrush x:Key="HoverOverlayBrush" Color="#0C000000"/>
    <SolidColorBrush x:Key="PressOverlayBrush" Color="#16000000"/>
    <SolidColorBrush x:Key="SelectedBrush" Color="#227C4DFF"/>
    <SolidColorBrush x:Key="TextSecondarySoftBrush" Color="#1C50566A"/>
    <LinearGradientBrush x:Key="CardGradientBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFF" Offset="0"/>
        <GradientStop Color="#F6F7FC" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CardEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FFFFFFFF" Offset="0"/>
        <GradientStop Color="#10000000" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="HeroGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3A8B5CF6" Offset="0"/>
        <GradientStop Color="#224F8CF0" Offset="0.6"/>
        <GradientStop Color="#08FFFFFF" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ScrimBrush" Color="#8C1B1E2A"/>

    <Color x:Key="AccentColor">#7C3AED</Color>
    <Color x:Key="AccentBlueColor">#3B6FE0</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#7C3AED"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#3B6FE0"/>
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1E7C3AED"/>
    <SolidColorBrush x:Key="AccentBlueSoftBrush" Color="#1E3B6FE0"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0"/>
        <GradientStop Color="#3B6FE0" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="SuccessBrush" Color="#0EA574"/>
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1C0EA574"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#D98E04"/>
    <SolidColorBrush x:Key="WarningSoftBrush" Color="#1CD98E04"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E04848"/>
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#1CE04848"/>
    <Color x:Key="ShadowColor">#1B1E2A</Color>
</ResourceDictionary>
