<UserControl x:Class="DownloadsCleaner.Views.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels">
    <UserControl.Resources>
        <Style x:Key="HistoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid Margin="28,6,28,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="0,0,0,14">
            <TextBlock Text="{loc:T HistoryTitle}" Style="{StaticResource TextTitle}"/>
            <TextBlock Style="{StaticResource TextSecondary}" Margin="0,4,0,0" TextWrapping="Wrap"
                       Text="{loc:T HistorySubtitle}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
            <Button Style="{StaticResource PrimaryButton}" Command="{Binding OpenRecycleBinCommand}" Height="38" Padding="18,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="14" Foreground="White"/>
                    <TextBlock Text="{loc:T HistoryOpenBin}" Margin="9,0,0,0"/>
                </StackPanel>
            </Button>
            <Button Style="{StaticResource GhostButton}" Content="{loc:T HistoryClear}" Command="{Binding ClearCommand}" Height="38" Margin="8,0,0,0"
                    IsEnabled="{Binding IsEmpty, Converter={StaticResource InverseBool}}"/>
        </StackPanel>

        <Grid Grid.Row="2">
            <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Items}" ItemContainerStyle="{StaticResource HistoryItemStyle}"
                     VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True" Margin="0,0,0,12">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,8" Padding="16,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}">
                                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}"/>
                                </Border>
                                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding TimeText, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SizeText, Mode=OneWay}"/>
                                        <Run Text="  ·  "/><Run Text="{Binding Details, Mode=OneWay}"/>
                                    </TextBlock>
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" Background="{DynamicResource WarningSoftBrush}" VerticalAlignment="Center"
                                        Margin="0,0,10,0" Visibility="{Binding WasUndone, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="{loc:T HistoryUndone}" Foreground="{DynamicResource WarningBrush}" FontSize="11" FontWeight="SemiBold"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="{loc:T CommonUndo}" Padding="14,7" VerticalAlignment="Center"
                                        Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.UndoCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceRepeat="True">
                <TextBlock Text="&#xE81C;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{loc:T HistoryEmptyTitle}" Style="{StaticResource TextHeading}" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                <TextBlock Text="{loc:T HistoryEmptyHint}" Style="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
