<UserControl x:Class="DownloadsCleaner.Views.PreviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels">
    <Border Style="{StaticResource Card}" Padding="16" Margin="0,0,0,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="{loc:T FilesPreviewHeader}" Style="{StaticResource TextHeading}" Margin="0,0,0,12"/>

            <!-- Пустое состояние -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                        Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                <TextBlock Text="&#xE890;" Style="{StaticResource IconText}" FontSize="34" Foreground="{DynamicResource TextMutedBrush}"/>
                <TextBlock Text="{loc:T PreviewSelectFile}" Style="{StaticResource TextSecondary}" Margin="0,10,0,0" HorizontalAlignment="Center"/>
            </StackPanel>

            <Grid Grid.Row="1" Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Область содержимого -->
                <Border CornerRadius="10" Background="{DynamicResource BgInputBrush}" ClipToBounds="True">
                    <Grid>
                        <!-- Изображение -->
                        <Image Source="{Binding Image}" Stretch="Uniform" Margin="8"
                               RenderOptions.BitmapScalingMode="HighQuality">
                            <Image.Style>
                                <Style TargetType="Image">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Image">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Image.Style>
                        </Image>

                        <!-- Текст -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ScrollViewer.Style>
                                <Style TargetType="ScrollViewer">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Text">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ScrollViewer.Style>
                            <TextBlock Text="{Binding Text}" Style="{StaticResource TextBody}" TextWrapping="Wrap" Margin="12"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12"/>
                        </ScrollViewer>

                        <!-- Видео / аудио -->
                        <MediaElement x:Name="Player" LoadedBehavior="Manual" UnloadedBehavior="Manual" Stretch="Uniform"
                                      MediaOpened="OnMediaOpened" MediaFailed="OnMediaFailed" MediaEnded="OnMediaEnded" Volume="0.7">
                            <MediaElement.Style>
                                <Style TargetType="MediaElement">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Video">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MediaElement.Style>
                        </MediaElement>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Audio">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <Border Width="84" Height="84" CornerRadius="24" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE8D6;" Style="{StaticResource IconText}" FontSize="36" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Информационная заглушка -->
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Kind}" Value="Info">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="&#xE7C3;" Style="{StaticResource IconText}" FontSize="34" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="{Binding Message}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap"
                                       TextAlignment="Center" Margin="0,10,0,0"/>
                        </StackPanel>

                        <ProgressBar Style="{StaticResource ModernProgress}" IsIndeterminate="True" VerticalAlignment="Top" Margin="8"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>

                <!-- Управление воспроизведением -->
                <Grid x:Name="MediaControls" Grid.Row="1" Margin="0,10,0,0" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="PlayButton" Style="{StaticResource IconButton}" Click="OnPlayPause" Content="&#xE768;"/>
                    <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="1" VerticalAlignment="Center" Margin="8,0"
                            Thumb.DragStarted="OnSeekStarted" Thumb.DragCompleted="OnSeekCompleted"/>
                    <TextBlock x:Name="TimeText" Grid.Column="2" Text="0:00" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                </Grid>
            </Grid>

            <!-- Сведения и действия -->
            <StackPanel Grid.Row="2" Margin="0,12,0,0" Visibility="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding File.Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding InfoLines}" Style="{StaticResource TextSecondary}" Margin="0,6,0,0" LineHeight="20"/>
                <TextBlock Text="{Binding File.FullPath}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T CommonOpen}" Command="{Binding OpenExternalCommand}" Margin="0,0,8,0" Padding="14,7"/>
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T PreviewInExplorer}" Command="{Binding ShowInExplorerCommand}" Padding="12,7"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
