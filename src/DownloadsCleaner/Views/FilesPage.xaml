<UserControl x:Class="DownloadsCleaner.Views.FilesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:ctl="clr-namespace:DownloadsCleaner.Controls"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
             xmlns:views="clr-namespace:DownloadsCleaner.Views">
    <Grid Margin="28,6,0,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,28,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <StackPanel Grid.Row="0" Margin="0,0,0,14">
                <TextBlock Text="{Binding Title}" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}" Margin="0,4,0,0"/>
            </StackPanel>

            <!-- Панель инструментов -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="190" MaxWidth="360"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Style="{StaticResource InputTextBox}" Tag="{Binding SearchHint}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Height="38" Padding="36,0,12,0"/>
                <TextBlock Grid.Column="0" Text="&#xE721;" Style="{StaticResource IconText}" HorizontalAlignment="Left"
                           Margin="12,0,0,0" IsHitTestVisible="False" FontSize="14"/>

                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Margin="10,0,0,0" Height="38" MinWidth="170"
                          ItemsSource="{Binding CategoryOptions}" ItemTemplate="{StaticResource CategoryOptionItemTemplate}"
                          SelectedValue="{Binding CategoryValue}" SelectedValuePath="Value"/>

                <Button Grid.Column="2" Margin="10,0,0,0" Height="38" Style="{StaticResource SecondaryButton}"
                        Command="{Binding ToggleFiltersCommand}" Padding="14,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE71C;" Style="{StaticResource IconText}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T FilesFilters}" Margin="8,0,0,0"/>
                        <Ellipse Width="7" Height="7" Margin="8,0,0,0" Fill="{DynamicResource AccentBrush}"
                                 Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Button>

                <Button Grid.Column="4" Height="38" Margin="10,0,0,0" Style="{StaticResource SecondaryButton}"
                        Command="{Binding TogglePreviewCommand}" Padding="14,0" ToolTip="{loc:T FilesPreviewPanelTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE890;" Style="{StaticResource IconText}" FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T FilesPreviewHeader}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Раскрывающаяся панель фильтров -->
            <ctl:ExpandablePanel Grid.Row="2" IsExpanded="{Binding FiltersExpanded}">
                <Border Style="{StaticResource Card}" Padding="14" Margin="0,0,0,10">
                    <WrapPanel>
                        <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,10,0" Height="36" MinWidth="170"
                                  ItemsSource="{Binding AgeOptions}" ItemTemplate="{StaticResource OptionItemTemplate}"
                                  SelectedValue="{Binding AgeDays}" SelectedValuePath="Value"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,10,0" Height="36" MinWidth="170"
                                  ItemsSource="{Binding SizeOptions}" ItemTemplate="{StaticResource OptionItemTemplate}"
                                  SelectedValue="{Binding MinSizeMb}" SelectedValuePath="Value"/>
                        <ComboBox Style="{StaticResource ModernComboBox}" Margin="0,0,10,0" Height="36" MinWidth="230"
                                  ItemsSource="{Binding RuleOptions}" ItemTemplate="{StaticResource OptionItemTemplate}"
                                  SelectedValue="{Binding Rule}" SelectedValuePath="Value"/>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T FilesResetFilters}" Height="36"
                                Command="{Binding ClearFiltersCommand}"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T FilesSelectAll}" Height="36"
                                Command="{Binding SelectAllCommand}" Margin="6,0,0,0"/>
                    </WrapPanel>
                </Border>
            </ctl:ExpandablePanel>

            <!-- Заголовки столбцов -->
            <Grid Grid.Row="3" Margin="0,2,0,4" Height="32">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="116"/>
                    <ColumnDefinition Width="92"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="84"/>
                </Grid.ColumnDefinitions>
                <CheckBox Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Center" IsThreeState="True"
                          IsChecked="{Binding AllSelected, Mode=OneWay}" Command="{Binding ToggleSelectAllCommand}"/>
                <Button Grid.Column="1" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static vm:FileSortKey.Name}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T FilesName}"/>
                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Name">
                                    <Binding Path="SortKey"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="2" Text="{loc:T FilesCategory}" Style="{StaticResource TextCaption}" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                <Button Grid.Column="3" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static vm:FileSortKey.Size}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T FilesSize}"/>
                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Size">
                                    <Binding Path="SortKey"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="4" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static vm:FileSortKey.Created}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T FilesCreated}"/>
                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Created">
                                    <Binding Path="SortKey"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Grid.Column="5" Style="{StaticResource ColumnHeaderButton}" Command="{Binding SortByCommand}"
                        CommandParameter="{x:Static vm:FileSortKey.Modified}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:T FilesModified}"/>
                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Margin="6,0,0,0" Foreground="{DynamicResource AccentBrush}">
                            <TextBlock.Text>
                                <MultiBinding Converter="{StaticResource SortGlyph}" ConverterParameter="Modified">
                                    <Binding Path="SortKey"/>
                                    <Binding Path="SortDescending"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Список -->
            <Grid Grid.Row="4">
                <ListBox x:Name="FileList" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Items}"
                         ItemContainerStyle="{StaticResource FileRowStyle}" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                         PreviewKeyDown="OnListKeyDown" MouseDoubleClick="OnListDoubleClick"
                         Margin="0,0,0,80">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:FileItemViewModel}">
                            <Grid ToolTip="{Binding FullPath}" Background="Transparent"
                                  Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}">
                                <Grid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{loc:T FilesOpen}" Tag="&#xE8E5;"
                                                  Command="{Binding PlacementTarget.Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:T FilesShowInExplorer}" Tag="&#xE838;"
                                                  Command="{Binding PlacementTarget.Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:T FilesCopyPath}" Tag="&#xE8C8;"
                                                  Command="{Binding PlacementTarget.Tag.CopyPathCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <MenuItem Header="{loc:T CommonPreview}" Tag="&#xE890;"
                                                  Command="{Binding PlacementTarget.Tag.PreviewItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                        <Separator/>
                                        <MenuItem Header="{loc:T FilesDeleteMenu}" Tag="&#xE74D;"
                                                  Command="{Binding PlacementTarget.Tag.DeleteOneCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding}"/>
                                    </ContextMenu>
                                </Grid.ContextMenu>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="116"/>
                                    <ColumnDefinition Width="92"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="132"/>
                                    <ColumnDefinition Width="84"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox Style="{StaticResource ModernCheckBox}" HorizontalAlignment="Center"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                                <Grid Grid.Column="1" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="10"
                                            Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" Style="{StaticResource IconText}"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MaxWidth="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding SourcePrefix}" Style="{StaticResource TextCaption}"
                                                       Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding SourceUrl}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Folder}" Style="{StaticResource TextCaption}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                                    <Ellipse Width="8" Height="8" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    <TextBlock Text="{Binding CategoryTitle}" Style="{StaticResource TextSecondary}" Margin="8,0,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource TextBody}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="4" Text="{Binding CreatedText}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <TextBlock Grid.Column="5" Text="{Binding ModifiedText}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <StackPanel Grid.Column="6" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0"
                                            m:Motion.State="Hover">
                                    <Button Style="{StaticResource IconButton}" Content="&#xE8E5;" Width="30" Height="30" ToolTip="{loc:T FilesOpenFile}"
                                            Command="{Binding Tag.OpenFileCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Style="{StaticResource IconButton}" Content="&#xE838;" Width="30" Height="30" ToolTip="{loc:T CommonShowInExplorer}"
                                            Command="{Binding Tag.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=Grid}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Пустое состояние -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-60,0,0"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}"
                            m:Motion.Entrance="Fade" m:Motion.EntranceRepeat="True">
                    <TextBlock Text="&#xE71E;" Style="{StaticResource IconText}" FontSize="40" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{loc:T FilesNothingFound}" Style="{StaticResource TextHeading}" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="{loc:T FilesEmptyCategoryHint}" Style="{StaticResource TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                   Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        <TextBlock Text="{loc:T FilesNoResultsHint}" Style="{StaticResource TextSecondary}"
                                   TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360"
                                   Visibility="{Binding HasActiveFilters, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Панель выбранных файлов -->
                <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,14" Padding="16,10"
                        CornerRadius="14" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1" Visibility="{Binding HasSelection, Converter={StaticResource BoolToVis}}"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceRepeat="True">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.4" Color="{DynamicResource ShadowColor}"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
                            <TextBlock Text="&#xE762;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}" FontSize="14"/>
                        </Border>
                        <TextBlock Text="{Binding SelectionSummary}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="12,0,18,0"/>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T FilesSort}" Command="{Binding SortSelectedCommand}"
                                Margin="0,0,8,0" Padding="14,8"/>
                        <Button Style="{StaticResource DangerButton}" Content="{loc:T FilesDelete}" Command="{Binding DeleteSelectedCommand}"
                                Margin="0,0,8,0" Padding="14,8"/>
                        <Button Style="{StaticResource GhostButton}" Content="{loc:T FilesDeselect}" Command="{Binding ClearSelectionCommand}" Padding="12,8"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Панель предпросмотра: ширина плавно меняется -->
        <Border Grid.Column="1" Width="0" ClipToBounds="True" m:Motion.AnimatedWidth="{Binding PreviewPanelWidth}">
            <views:PreviewPanel DataContext="{Binding Preview}" Width="360" Margin="0,0,0,0"/>
        </Border>
    </Grid>
</UserControl>
