<UserControl x:Class="DownloadsCleaner.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
             xmlns:ctl="clr-namespace:DownloadsCleaner.Controls"
             xmlns:models="clr-namespace:DownloadsCleaner.Models">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <Grid Margin="28,6,28,32">
            <StackPanel MaxWidth="860" HorizontalAlignment="Left">
                <TextBlock Text="{loc:T SettingsTitle}" Style="{StaticResource TextTitle}"/>
                <TextBlock Text="{loc:T SettingsSubtitle}" Style="{StaticResource TextSecondary}" Margin="0,4,0,18"/>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="40">
                    <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsFolders}" Margin="0,4,0,4"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsDownloadsFolder}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding Settings.DownloadsPath}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T CommonChange}" Command="{Binding ChangeDownloadsPathCommand}" Padding="14,7"/>
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T CommonDefault}" Command="{Binding ResetDownloadsPathCommand}" Padding="12,7" Margin="6,0,0,0"/>
                        </StackPanel></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsSortDestination}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{Binding DestinationText}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Content="{loc:T CommonChange}" Command="{Binding ChangeSortDestinationCommand}" Padding="14,7"/>
                            <Button Style="{StaticResource GhostButton}" Content="{loc:T CommonReset}" Command="{Binding ResetSortDestinationCommand}" Padding="12,7" Margin="6,0,0,0"/>
                        </StackPanel></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsScanSubfolders}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsScanSubfoldersHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.IncludeSubfolders, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="80">
                    <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsBehavior}" Margin="0,4,0,4"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsScanOnStartup}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsScanOnStartupHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.ScanOnStartup, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsWatchNewFiles}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsWatchNewFilesHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.WatchNewFiles, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsAutoSort}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsAutoSortHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.AutoSortNewFiles, Mode=TwoWay}" IsEnabled="{Binding Settings.WatchNewFiles}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsOldPeriod}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsOldPeriodHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox Style="{StaticResource ModernComboBox}" MinWidth="150" Height="36" ItemsSource="{Binding OldDaysOptions}" ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValue="{Binding OldDaysValue}" SelectedValuePath="Value"/></ContentControl>
                    </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="120">
                    <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsNotifications}" Margin="0,4,0,4"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsShowNotifications}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsShowNotificationsHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.ShowNotifications, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsNotifyNewFiles}"/>
                            
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.NotifyOnNewFiles, Mode=TwoWay}" IsEnabled="{Binding Settings.ShowNotifications}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsToastTime}"/>
                            
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox Style="{StaticResource ModernComboBox}" MinWidth="150" Height="36" ItemsSource="{Binding ToastSecondsOptions}" ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValue="{Binding ToastSecondsValue}" SelectedValuePath="Value"/></ContentControl>
                    </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="160">
                    <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsAppearance}" Margin="0,4,0,4"/>
                    <StackPanel Margin="0,9">
                        <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsTheme}"/>
                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,10" Text="{loc:T SettingsThemeHint}"/>
                        <!-- Галерея тем: мини-окно в цветах темы, выбранная обведена акцентом -->
                        <ItemsControl ItemsSource="{Binding ThemeCards}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:ThemeCard}">
                                    <Button Command="{Binding DataContext.SelectThemeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Margin="0,0,12,12" Cursor="Hand" ToolTip="{Binding Label}"
                                            m:Motion.HoverScale="1.04" m:Motion.PressScale="0.97">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <ContentPresenter/>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <StackPanel Width="126">
                                            <Grid>
                                                <!-- Мини-окно -->
                                                <Border Height="78" CornerRadius="12" Background="{Binding Background}" BorderThickness="1"
                                                        BorderBrush="{DynamicResource StrokeBrush}" ClipToBounds="True">
                                                    <Grid Margin="10">
                                                        <Border CornerRadius="7" Background="{Binding Card}" Padding="8,7">
                                                            <StackPanel>
                                                                <Border Height="8" CornerRadius="4" Width="56" HorizontalAlignment="Left">
                                                                    <Border.Background>
                                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                            <GradientStop Color="{Binding AccentFrom}" Offset="0"/>
                                                                            <GradientStop Color="{Binding AccentTo}" Offset="1"/>
                                                                        </LinearGradientBrush>
                                                                    </Border.Background>
                                                                </Border>
                                                                <Border Height="5" CornerRadius="2.5" Width="72" Margin="0,7,0,0" HorizontalAlignment="Left"
                                                                        Background="{Binding AccentTo}" Opacity="0.35"/>
                                                                <Border Height="5" CornerRadius="2.5" Width="44" Margin="0,5,0,0" HorizontalAlignment="Left"
                                                                        Background="{Binding AccentFrom}" Opacity="0.25"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                                <!-- Выбранная тема: акцентная рамка и галочка -->
                                                <Border CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                        m:Motion.Entrance="Pop" m:Motion.EntranceRepeat="True"/>
                                                <Border Width="22" Height="22" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                                                        Background="{DynamicResource AccentGradientBrush}"
                                                        Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                        m:Motion.Entrance="Pop" m:Motion.EntranceRepeat="True">
                                                    <TextBlock Text="&#xE73E;" Style="{StaticResource IconText}" FontSize="11" Foreground="White"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding Label}" Style="{StaticResource TextBody}" Margin="2,8,0,0" TextTrimming="CharacterEllipsis"
                                                       FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsLanguage}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ComboBox Style="{StaticResource ModernComboBox}" MinWidth="190" Height="36" ItemsSource="{Binding LanguageOptions}" ItemTemplate="{StaticResource OptionItemTemplate}" SelectedValue="{Binding LanguageValue}" SelectedValuePath="Value"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsAnimations}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsAnimationsHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.AnimationsEnabled, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,-4,0,14" Padding="16,10" Background="{DynamicResource WarningSoftBrush}"
                        BorderBrush="{DynamicResource WarningBrush}" Visibility="{Binding SystemAnimationsBlocked, Converter={StaticResource BoolToVis}}">
                    <TextBlock Style="{StaticResource TextBody}" TextWrapping="Wrap"
                               Text="{loc:T SettingsAnimationsBlocked}"/>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="200">
                    <StackPanel>
                    <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsSecurity}" Margin="0,4,0,4"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsAllowHashing}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsAllowHashingHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.AllowContentHashing, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    <Border Height="1" Background="{DynamicResource StrokeBrush}"/>
                    <Grid Margin="0,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsAllowPermanent}"/>
                            <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsAllowPermanentHint}"/>
                        </StackPanel>
                        <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.AllowPermanentDelete, Mode=TwoWay}"/></ContentControl>
                    </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="240">
                    <StackPanel>
                        <Button Style="{StaticResource GhostButton}" Click="OnToggleRules" HorizontalContentAlignment="Stretch" Padding="0,4">
                            <Grid>
                                <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsRules}" HorizontalAlignment="Left"/>
                                <TextBlock x:Name="RulesChevron" Text="&#xE70D;" Style="{StaticResource IconText}" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                        </Button>
                        <ctl:ExpandablePanel x:Name="RulesPanel" IsExpanded="False">
                            <StackPanel Margin="0,10,0,4">
                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsExcludedExtensions}"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="{loc:T SettingsExcludedExtensionsHint}"/>
                                <TextBox Style="{StaticResource InputTextBox}" Height="38" Tag="{Binding ExcludedExtensionsPlaceholder}"
                                         Text="{Binding ExcludedExtensionsText, UpdateSourceTrigger=LostFocus}"/>

                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsExcludedFolders}" Margin="0,18,0,0"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="{loc:T SettingsExcludedFoldersHint}"/>
                                <ItemsControl ItemsSource="{Binding Settings.ExcludedFolders}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,8">
                                                    <TextBlock Text="{Binding}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                                                </Border>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="{loc:T CommonRemove}"
                                                        Command="{Binding DataContext.RemoveExcludedFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Style="{StaticResource SecondaryButton}" Content="{loc:T SettingsAddFolder}" Command="{Binding AddExcludedFolderCommand}"
                                        HorizontalAlignment="Left" Padding="14,7"/>

                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsCustomRules}" Margin="0,18,0,0"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,8" TextWrapping="Wrap"
                                           Text="{loc:T SettingsCustomRulesHint}"/>
                                <ItemsControl ItemsSource="{Binding Settings.CustomRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ExtensionRule}">
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Style="{StaticResource InputTextBox}" Height="36" Tag="{Binding RuleExtensionPlaceholder}" Text="{Binding Extension, UpdateSourceTrigger=LostFocus}"/>
                                                <ComboBox Grid.Column="1" Style="{StaticResource ModernComboBox}" Height="36" Margin="8,0,0,0" MinWidth="170"
                                                          ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedItem="{Binding Category}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <TextBlock Text="{Binding Converter={StaticResource CategoryTitle}}"/>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Margin="6,0,0,0" ToolTip="{loc:T SettingsRemoveRule}"
                                                        Command="{Binding DataContext.RemoveRuleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource SecondaryButton}" Content="{loc:T SettingsAddRule}" Command="{Binding AddRuleCommand}" Padding="14,7"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:T SettingsApplyRules}" Command="{Binding ApplyRulesCommand}"
                                            Padding="14,7" Margin="8,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </ctl:ExpandablePanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}" Margin="0,0,0,14" Padding="22,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="280">
                    <StackPanel>
                        <TextBlock Style="{StaticResource TextHeading}" Text="{loc:T SettingsAbout}" Margin="0,4,0,8"/>
                        <TextBlock Style="{StaticResource TextBody}"><Run Text="Downloads Cleaner "/><Run Text="{Binding Version, Mode=OneWay}"/></TextBlock>

                        <!-- Обновления (только там, где они поддерживаются) -->
                        <Border Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}" Margin="0,12,0,4" Padding="16,14"
                                CornerRadius="12" Background="{DynamicResource BgElevatedBrush}" BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1"
                                DataContext="{Binding Updates}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36" Height="36" CornerRadius="11" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="&#xE895;" Style="{StaticResource IconText}" FontSize="16" Foreground="{DynamicResource AccentBrush}"
                                                   m:Motion.SpinWhen="{Binding IsBusy}"/>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{loc:T UpdTitle}" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" Margin="0,2,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T UpdCheck}" Command="{Binding CheckCommand}" Padding="14,7"/>
                                        <Button Style="{StaticResource PrimaryButton}" Content="{Binding InstallText}" Command="{Binding InstallCommand}" Padding="14,7"
                                                Margin="8,0,0,0" Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                                <ProgressBar Style="{StaticResource ModernProgress}" Height="6" Margin="0,12,0,0" Maximum="1"
                                             m:Motion.AnimatedValue="{Binding Progress}"
                                             Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVis}}"/>
                                <TextBlock Text="{Binding Notes}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="48,10,0,0"
                                           Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource GhostButton}" Content="{loc:T UpdOpenPage}" Command="{Binding OpenReleasePageCommand}"
                                        HorizontalAlignment="Left" Padding="10,5" Margin="40,6,0,0"
                                        Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Border>
                        <Grid Margin="0,6,0,8" Visibility="{Binding HasUpdates, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,20,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold" Text="{loc:T SettingsCheckUpdates}"/>
                                <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,2,0,0" Text="{loc:T SettingsCheckUpdatesHint}"/>
                            </StackPanel>
                            <ContentControl Grid.Column="1" VerticalAlignment="Center"><ToggleButton Style="{StaticResource SwitchToggle}" IsChecked="{Binding Settings.CheckUpdatesOnStartup, Mode=TwoWay}"/></ContentControl>
                        </Grid>
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,6,0,0" TextWrapping="Wrap"><Run Text="{loc:T SettingsPathLabel}"/><Run Text="{Binding SettingsPath, Mode=OneWay}"/></TextBlock>
                        <TextBlock Style="{StaticResource TextCaption}" Margin="0,2,0,10" TextWrapping="Wrap"><Run Text="{loc:T SettingsLogLabel}"/><Run Text="{Binding LogDirectory, Mode=OneWay}"/></TextBlock>
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T SettingsOpenLogFolder}" Command="{Binding OpenLogFolderCommand}"
                                HorizontalAlignment="Left" Padding="14,7"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
