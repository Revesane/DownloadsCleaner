<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
                    xmlns:m="clr-namespace:DownloadsCleaner.Animations"
                    xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
                    xmlns:models="clr-namespace:DownloadsCleaner.Models">

    <Style x:Key="DialogCard" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="26,24"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect BlurRadius="40" ShadowDepth="12" Opacity="0.5" Color="{DynamicResource ShadowColor}"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Простое подтверждение ===== -->
    <DataTemplate DataType="{x:Type vm:ConfirmDialogViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="500">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextHeading}" FontSize="19" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <TextBlock Text="{Binding Message}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" LineHeight="20" Margin="0,16,0,22"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="{Binding CancelText}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDanger}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Подтверждение удаления ===== -->
    <DataTemplate DataType="{x:Type vm:DeleteConfirmDialogViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="640">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource DangerSoftBrush}">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource TextHeading}" FontSize="19"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock Text="{Binding Hint}" Style="{StaticResource TextSecondary}" Margin="0,14,0,10" TextWrapping="Wrap"/>

                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="6">
                    <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Files}" MaxHeight="230"
                             ItemContainerStyle="{StaticResource PlainItem}" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FileEntry}">
                                <Grid Height="40" Margin="6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" Style="{StaticResource IconText}"
                                               Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}" HorizontalAlignment="Left"/>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Directory}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Text="{Binding Size, Converter={StaticResource Bytes}}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <StackPanel Visibility="{Binding PermanentAllowed, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                    <CheckBox Style="{StaticResource ModernCheckBox}" Content="{loc:T DialogDeletePermanent}"
                              IsChecked="{Binding UsePermanent, Mode=TwoWay}"/>
                    <Border Margin="0,10,0,0" Padding="14,10" CornerRadius="10" Background="{DynamicResource DangerSoftBrush}"
                            Visibility="{Binding NeedsAcknowledge, Converter={StaticResource BoolToVis}}"
                            m:Motion.Entrance="FadeUp" m:Motion.EntranceRepeat="True">
                        <CheckBox Style="{StaticResource ModernCheckBox}" IsChecked="{Binding Acknowledged, Mode=TwoWay}"
                                  Content="{loc:T DialogDeletePermanentConfirm}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T CommonCancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Content="{Binding ConfirmText}" Command="{Binding ConfirmCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding UsePermanent}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Предпросмотр сортировки ===== -->
    <DataTemplate DataType="{x:Type vm:SortPreviewDialogViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="780">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource AccentSoftBrush}">
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T DialogSortTitle}" Style="{StaticResource TextHeading}" FontSize="19"/>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource TextSecondary}" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <ProgressBar Style="{StaticResource ModernProgress}" IsIndeterminate="True" Height="3" Margin="0,12,0,0"
                             Visibility="{Binding IsBuilding, Converter={StaticResource BoolToVis}}"/>

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="9" Padding="12,9">
                        <StackPanel>
                            <TextBlock Text="{loc:T DialogDestination}" Style="{StaticResource TextCaption}"/>
                            <TextBlock Text="{Binding Destination}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>
                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="{loc:T CommonChange}" Command="{Binding ChangeDestinationCommand}"
                            Margin="8,0,0,0"/>
                </Grid>

                <CheckBox Style="{StaticResource ModernCheckBox}" Margin="0,12,0,0" Content="{loc:T DialogIncludeSubfolders}"
                          IsChecked="{Binding IncludeSubfolders, Mode=TwoWay}"
                          Visibility="{Binding CanChangeScope, Converter={StaticResource BoolToVis}}"/>

                <ItemsControl ItemsSource="{Binding CategoryLines}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Badge}" Margin="0,0,8,6" Padding="10,4">
                                <TextBlock Text="{Binding}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="6" Margin="0,6,0,0">
                    <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Rows}" Height="250"
                             ItemContainerStyle="{StaticResource PlainItem}" VirtualizingPanel.IsVirtualizing="True"
                             VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SortPreviewRow}">
                                <Grid Height="44" Margin="8,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="80"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis" MaxWidth="420"/>
                                            <Border Style="{StaticResource Badge}" Margin="8,0,0,0" Background="{DynamicResource WarningSoftBrush}"
                                                    Visibility="{Binding Renamed, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="{loc:T DialogRenamed}" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Target}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="{Binding Size}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <TextBlock Text="{Binding Notes}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,10,0,0"/>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                    <Button Style="{StaticResource GhostButton}" Content="{loc:T CommonCancel}" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="{loc:T DialogMoveFiles}" Command="{Binding ConfirmCommand}"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- ===== Список ошибок ===== -->
    <DataTemplate DataType="{x:Type vm:ErrorListDialogViewModel}">
        <Border Style="{StaticResource DialogCard}" Width="640">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Border Width="42" Height="42" CornerRadius="13" Background="{DynamicResource DangerSoftBrush}">
                        <TextBlock Text="&#xE783;" Style="{StaticResource IconText}" FontSize="18" Foreground="{DynamicResource DangerBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextHeading}" FontSize="19" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="6" Margin="0,16,0,0">
                    <ListBox Style="{StaticResource PlainListBox}" ItemsSource="{Binding Failures}" MaxHeight="300"
                             ItemContainerStyle="{StaticResource PlainItem}" VirtualizingPanel.IsVirtualizing="True"
                             ScrollViewer.CanContentScroll="True">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:FailedOperation}">
                                <StackPanel Margin="10,8">
                                    <TextBlock Text="{Binding Path}" Style="{StaticResource TextBody}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Reason}" Style="{StaticResource TextCaption}" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Content="{loc:T CommonClose}" Command="{Binding CancelCommand}"
                        HorizontalAlignment="Right" Margin="0,18,0,0"/>
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
