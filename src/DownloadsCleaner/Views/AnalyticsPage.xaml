<UserControl x:Class="DownloadsCleaner.Views.AnalyticsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:ctl="clr-namespace:DownloadsCleaner.Controls"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,6,28,32">
            <StackPanel Margin="0,0,0,18" m:Motion.Entrance="FadeUp">
                <TextBlock Text="{loc:T AnalyticsTitle}" Style="{StaticResource TextTitle}"/>
                <TextBlock Style="{StaticResource TextSecondary}" Margin="0,4,0,0"
                           Text="{loc:T AnalyticsSubtitle}"/>
            </StackPanel>

            <!-- Пустое состояние -->
            <Border Style="{StaticResource Card}" Padding="32" Visibility="{Binding HasData, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                    m:Motion.Entrance="FadeUp">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="&#xE9D9;" Style="{StaticResource IconText}" FontSize="38" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{loc:T AnalyticsEmptyTitle}" Style="{StaticResource TextHeading}" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="{loc:T AnalyticsEmptyHint}" Style="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>

            <StackPanel Visibility="{Binding HasData, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Распределение по категориям -->
                    <Border Style="{StaticResource Card}" Padding="22" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="40">
                        <StackPanel>
                            <TextBlock Text="{loc:T AnalyticsByCategory}" Style="{StaticResource TextHeading}"/>
                            <Grid Height="250" Margin="0,10">
                                <ctl:DonutChart Segments="{Binding Segments}" Thickness="26" Width="236" Height="236"/>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <ctl:AnimatedNumber Value="{Binding TotalBytes}" Format="Bytes" FontSize="26" FontWeight="SemiBold"
                                                        FontFamily="{StaticResource DisplayFont}" HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:T AnalyticsTotalInFolder}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Legend}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:LegendRow}">
                                        <Grid Margin="0,5">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="56"/>
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Width="10" Height="10" Fill="{Binding Category, Converter={StaticResource CategoryBrush}}" VerticalAlignment="Center"/>
                                            <StackPanel Grid.Column="1" Margin="10,0">
                                                <TextBlock Style="{StaticResource TextBody}" FontWeight="SemiBold">
                                                    <Run Text="{Binding Title, Mode=OneWay}"/><Run Text="  "/><Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </TextBlock>
                                                <ProgressBar Style="{StaticResource FillProgress}" Height="4" Margin="0,5,0,0" m:Motion.AnimatedValue="{Binding Share}"
                                                             Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="2" Text="{Binding BytesText}" Style="{StaticResource TextBody}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="{Binding PercentText}" Style="{StaticResource TextCaption}" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Возраст + диск -->
                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource Card}" Padding="22" Margin="0,0,0,14" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="90">
                            <StackPanel>
                                <TextBlock Text="{loc:T AnalyticsByAge}" Style="{StaticResource TextHeading}"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,3,0,10" Text="{loc:T AnalyticsAgeHint}"/>
                                <ItemsControl ItemsSource="{Binding AgeRows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AgeRow}">
                                            <Grid Margin="0,7">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="90"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" FontWeight="SemiBold"/>
                                                    <TextBlock Style="{StaticResource TextCaption}"><Run Text="{Binding Count, Mode=OneWay}"/><Run Text="{loc:T AnalyticsFilesSuffix}"/></TextBlock>
                                                </StackPanel>
                                                <ProgressBar Grid.Column="1" Style="{StaticResource ModernProgress}" Height="8" VerticalAlignment="Center" Margin="8,0"
                                                             m:Motion.AnimatedValue="{Binding Share}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding BytesText}" Style="{StaticResource TextBody}" TextAlignment="Right" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Padding="22" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="140">
                            <StackPanel>
                                <TextBlock Text="{Binding DiskTitle}" Style="{StaticResource TextHeading}"/>
                                <TextBlock Text="{Binding DiskDetail}" Style="{StaticResource TextSecondary}" Margin="0,4,0,12" TextWrapping="Wrap"/>
                                <ProgressBar Style="{StaticResource ModernProgress}" Height="10" m:Motion.AnimatedValue="{Binding DiskFraction}"/>
                                <TextBlock Style="{StaticResource TextCaption}" Margin="0,10,0,0" TextWrapping="Wrap">
                                    <Run Text="{loc:T AnalyticsFolderPrefix}"/><Run Text="{Binding FolderShare, StringFormat=P1, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="{loc:T AnalyticsFolderSuffix}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Самые крупные файлы -->
                <Border Style="{StaticResource Card}" Padding="22,18" Margin="0,14,0,0" m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="190">
                    <StackPanel>
                        <TextBlock Text="{loc:T AnalyticsBiggest}" Style="{StaticResource TextHeading}" Margin="0,0,0,8"/>
                        <ItemsControl ItemsSource="{Binding Biggest}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BigFileRow}">
                                    <Grid Height="48" Background="Transparent" ToolTip="{Binding Entry.FullPath}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="40"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.ColumnSpan="4" CornerRadius="8" Background="{DynamicResource HoverOverlayBrush}" Opacity="0"
                                                m:Motion.State="Hover" IsHitTestVisible="False"/>
                                        <Border Width="30" Height="30" CornerRadius="9" Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=soft}">
                                            <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" Style="{StaticResource IconText}" FontSize="14"
                                                       Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,8,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource TextBody}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Text="{Binding Folder}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" TextAlignment="Right"/>
                                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE838;" ToolTip="{loc:T CommonShowInExplorer}"
                                                Command="{Binding DataContext.ShowInExplorerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
