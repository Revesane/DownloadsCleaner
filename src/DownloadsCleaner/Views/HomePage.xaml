<UserControl x:Class="DownloadsCleaner.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             xmlns:m="clr-namespace:DownloadsCleaner.Animations"
             xmlns:ctl="clr-namespace:DownloadsCleaner.Controls"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,6,28,32">

            <!-- Заголовок -->
            <Grid Margin="0,0,0,20" m:Motion.Entrance="FadeUp">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{loc:T HomeTitle}" Style="{StaticResource TextTitle}"/>
                    <TextBlock Text="{Binding FolderPath}" Style="{StaticResource TextSecondary}" Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ctl:HintButton HintId="home" Style="{StaticResource GhostButton}" Padding="12,10" Margin="0,0,8,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding ScanCommand}" Padding="18,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" Foreground="White" FontSize="14"/>
                            <TextBlock Text="{loc:T HomeScanAgain}" Margin="9,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Как это работает -->
            <ctl:HintPanel HintId="home" TitleKey="HintHomeTitle">
                <ctl:HintStep Glyph="&#xE890;" TitleKey="HintHome1Title" TextKey="HintHome1Text"/>
                <ctl:HintStep Glyph="&#xE9D9;" TitleKey="HintHome2Title" TextKey="HintHome2Text"/>
                <ctl:HintStep Glyph="&#xE82F;" TitleKey="HintHome3Title" TextKey="HintHome3Text"/>
                <ctl:HintStep Glyph="&#xEA18;" TitleKey="HintHome4Title" TextKey="HintHome4Text"/>
            </ctl:HintPanel>

            <!-- Подсказка до первого сканирования -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,16"
                    Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"
                    Background="{DynamicResource AccentSoftBrush}" BorderBrush="{DynamicResource AccentBrush}"
                    m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="60">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" FontSize="22" Foreground="{DynamicResource AccentBrush}"/>
                    <StackPanel Grid.Column="1" Margin="14,0">
                        <TextBlock Text="{loc:T HomeNotScannedTitle}" Style="{StaticResource TextHeading}"/>
                        <TextBlock Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,3,0,0"
                                   Text="{loc:T HomeNotScannedText}"/>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="{loc:T HomeScan}" Command="{Binding ScanCommand}"/>
                </Grid>
            </Border>

            <!-- Герой: итог сканирования -->
            <Border Style="{StaticResource Card}" Padding="26,22" Margin="0,0,0,16" Background="{DynamicResource HeroGradientBrush}"
                    Visibility="{Binding HasScanned, Converter={StaticResource BoolToVis}}"
                    m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="64" Height="64" CornerRadius="20" Background="{DynamicResource AccentGradientBrush}">
                        <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" FontSize="28" Foreground="White"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="20,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T HomeFoundPrefix}" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="SemiBold"/>
                            <ctl:AnimatedNumber Value="{Binding TotalBytes}" Format="Bytes" FontFamily="{StaticResource DisplayFont}" FontSize="26"
                                                FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Text="{loc:T HomeCanFreePrefix}" Style="{StaticResource TextSecondary}" FontSize="14"/>
                            <ctl:AnimatedNumber Value="{Binding FreeableBytes}" Format="Bytes" FontSize="14" FontWeight="SemiBold"
                                                Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{loc:T HomeTempAndCopies}" Style="{StaticResource TextCaption}" FontSize="12" VerticalAlignment="Bottom" Margin="4,0,0,1"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource SecondaryButton}" Content="{loc:T HomeAnalytics}" Command="{Binding ShowAnalyticsCommand}" Padding="16,10" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding ShowLargeCommand}" Padding="18,10">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{loc:T HomeFreeSpace}" />
                                <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="11" Foreground="White" Margin="8,0,0,0"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Умные советы: появляется, когда найдено, что можно удалить без потерь -->
            <Button Style="{StaticResource CardButton}" Command="{Binding ShowTipsCommand}" Padding="20,16" Margin="0,0,0,16"
                    HorizontalContentAlignment="Stretch"
                    Visibility="{Binding Tips.HasTips, Converter={StaticResource BoolToVis}, FallbackValue=Collapsed}"
                    m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="40">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="44" Height="44" CornerRadius="14" Background="{DynamicResource SuccessSoftBrush}">
                        <TextBlock Text="&#xE82F;" Style="{StaticResource IconText}" FontSize="20" Foreground="{DynamicResource SuccessBrush}"/>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:T HomeTipsPrefix}" Style="{StaticResource TextBody}" FontWeight="SemiBold" FontSize="15"/>
                            <ctl:AnimatedNumber Value="{Binding Tips.TotalBytes}" Format="Bytes" FontSize="15" FontWeight="SemiBold"
                                                Foreground="{DynamicResource SuccessBrush}"/>
                            <TextBlock Text="{loc:T HomeTipsSuffix}" Style="{StaticResource TextBody}" FontWeight="SemiBold" FontSize="15"/>
                        </StackPanel>
                        <TextBlock Text="{loc:T HomeTipsHint}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{loc:T HomeTipsOpen}" Style="{StaticResource TextBody}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                        <TextBlock Text="&#xE76C;" Style="{StaticResource IconText}" FontSize="11" Foreground="{DynamicResource AccentBrush}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Button>

            <!-- Сводка -->
            <UniformGrid Columns="3" Margin="0,0,-12,0">
                <Button Style="{StaticResource CardButton}" Command="{Binding ShowAllCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="40">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE8B7;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeTotalFiles}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding TotalFiles}" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T HomeTotalFilesHint}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Command="{Binding ShowAllCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="80">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBlueSoftBrush}">
                                <TextBlock Text="&#xEDA2;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBlueBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeFolderSize}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding TotalBytes}" Format="Bytes" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T HomeFolderSizeHint}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Command="{Binding SortCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="120">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentSoftBrush}">
                                <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeSortable}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding SortableCount}" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T HomeSortableHint}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Command="{Binding ShowOldCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="160">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource WarningSoftBrush}">
                                <TextBlock Text="&#xE787;" Style="{StaticResource IconText}" Foreground="{DynamicResource WarningBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeOldFiles}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding OldCount}" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding OldCaption}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Command="{Binding ShowDuplicatesCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="200">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBlueSoftBrush}">
                                <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" Foreground="{DynamicResource AccentBlueBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeDuplicates}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding DuplicateCopies}" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}">
                            <ctl:AnimatedNumber.Style>
                                <Style TargetType="ctl:AnimatedNumber">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding DuplicatesKnown}" Value="False">
                                            <Setter Property="Placeholder" Value="—"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ctl:AnimatedNumber.Style>
                        </ctl:AnimatedNumber>
                        <StackPanel Margin="0,2,0,0">
                            <TextBlock Text="{loc:T HomeExtraCopies}" Style="{StaticResource TextCaption}"
                                       Visibility="{Binding DuplicatesKnown, Converter={StaticResource BoolToVis}}"/>
                            <TextBlock Text="{loc:T HomeDupNotSearched}" Style="{StaticResource TextCaption}"
                                       Visibility="{Binding DuplicatesKnown, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        </StackPanel>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource CardButton}" Command="{Binding ShowTemporaryCommand}" Margin="0,0,12,12"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="240">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource SuccessSoftBrush}">
                                <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" Foreground="{DynamicResource SuccessBrush}"/>
                            </Border>
                            <TextBlock Text="{loc:T HomeCanFreeLower}" Style="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <ctl:AnimatedNumber Value="{Binding FreeableBytes}" Format="Bytes" FontSize="32" FontWeight="SemiBold" Margin="0,14,0,0"
                                            FontFamily="{StaticResource DisplayFont}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{loc:T HomeCanFreeHint}" Style="{StaticResource TextCaption}" Margin="0,2,0,0"/>
                    </StackPanel>
                </Button>
            </UniformGrid>

            <!-- Категории -->
            <TextBlock Text="{loc:T HomeCategories}" Style="{StaticResource TextHeading}" Margin="0,14,0,12"/>
            <ItemsControl ItemsSource="{Binding Categories}" AlternationCount="8" Margin="0,0,-12,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="4"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:CategoryCardViewModel}">
                        <Button Style="{StaticResource CardButton}" Margin="0,0,12,12"
                                Command="{Binding DataContext.OpenCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}"
                                m:Motion.Entrance="FadeUp"
                                m:Motion.EntranceDelay="{Binding (ItemsControl.AlternationIndex), RelativeSource={RelativeSource AncestorType=ContentPresenter}, Converter={StaticResource Mul}, ConverterParameter=45}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="34" Height="34" CornerRadius="10"
                                            Background="{Binding Category, Converter={StaticResource CategoryBrush}, ConverterParameter=soft}">
                                        <TextBlock Text="{Binding Category, Converter={StaticResource CategoryGlyph}}" Style="{StaticResource IconText}"
                                                   Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource TextBody}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <ctl:AnimatedNumber Value="{Binding Count}" FontSize="22" FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{loc:T HomeFilesSuffix}" Style="{StaticResource TextCaption}" VerticalAlignment="Bottom" Margin="6,0,0,3"/>
                                </StackPanel>
                                <ctl:AnimatedNumber Value="{Binding Bytes}" Format="Bytes" FontSize="12" Margin="0,2,0,12"
                                                    Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ProgressBar Style="{StaticResource FillProgress}" m:Motion.AnimatedValue="{Binding Share}"
                                             Foreground="{Binding Category, Converter={StaticResource CategoryBrush}}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Быстрые действия -->
            <TextBlock Text="{loc:T HomeQuickActions}" Style="{StaticResource TextHeading}" Margin="0,10,0,12"/>
            <UniformGrid Columns="4" Margin="0,0,-12,0">
                <Button Style="{StaticResource CardButton}" Command="{Binding SortCommand}" Margin="0,0,12,12" Padding="16"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="300">
                    <StackPanel>
                        <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T HomeSortByFolders}" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="{loc:T HomeSortPreviewHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding ShowLargeCommand}" Margin="0,0,12,12" Padding="16"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="340">
                    <StackPanel>
                        <TextBlock Text="&#xE7B8;" Style="{StaticResource IconText}" FontSize="20" Foreground="{DynamicResource AccentBlueBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T HomeLargeFiles}" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{loc:T HomeLargeHint}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding ShowTemporaryCommand}" Margin="0,0,12,12" Padding="16"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="380">
                    <StackPanel>
                        <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" FontSize="20" Foreground="{DynamicResource SuccessBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T HomeTempFiles}" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Style="{StaticResource TextCaption}" TextWrapping="Wrap" Text="{loc:T HomeTempHint}"/>
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource CardButton}" Command="{Binding ShowDuplicatesCommand}" Margin="0,0,12,12" Padding="16"
                        m:Motion.Entrance="FadeUp" m:Motion.EntranceDelay="420">
                    <StackPanel>
                        <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" FontSize="20" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Left"/>
                        <TextBlock Text="{loc:T HomeDupSearch}" Style="{StaticResource TextBody}" FontWeight="SemiBold" Margin="0,10,0,2"/>
                        <TextBlock Text="{loc:T HomeDupHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Button>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
