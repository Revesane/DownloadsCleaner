<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
                    xmlns:views="clr-namespace:DownloadsCleaner.Views">
    <!-- Соответствие ViewModel -> страница. Страница создаётся заново при каждом переходе (так проигрывается её анимация появления). -->
    <DataTemplate DataType="{x:Type vm:HomeViewModel}"><views:HomePage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:FileListViewModel}"><views:FilesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DuplicatesViewModel}"><views:DuplicatesPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:HistoryViewModel}"><views:HistoryPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AnalyticsViewModel}"><views:AnalyticsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsPage/></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SmartTipsViewModel}"><views:SmartTipsPage/></DataTemplate>
</ResourceDictionary>
