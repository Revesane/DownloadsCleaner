<Window x:Class="DownloadsCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
        xmlns:m="clr-namespace:DownloadsCleaner.Animations"
        xmlns:ctl="clr-namespace:DownloadsCleaner.Controls"
        xmlns:svc="clr-namespace:DownloadsCleaner.Services"
        xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
        Title="Downloads Cleaner" Icon="Assets/app.ico" Width="1360" Height="860" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal"
        PreviewKeyDown="OnPreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="56" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                      UseAeroCaptionButtons="False" NonClientFrameEdges="None"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid x:Name="Shell" m:Motion.Entrance="Pop">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ============ Боковая панель ============ -->
            <Border Grid.Column="0" Width="252" Background="{DynamicResource BgSidebarBrush}" BorderBrush="{DynamicResource StrokeBrush}"
                    BorderThickness="0,0,1,0" ClipToBounds="True" m:Motion.AnimatedWidth="{Binding SidebarWidth}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="64"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Border Width="32" Height="32" CornerRadius="10" Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="&#xE896;" Style="{StaticResource IconText}" Foreground="White" FontSize="15"/>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center" Width="170"
                                Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                            <TextBlock Text="Downloads" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,-2"/>
                            <TextBlock Text="Cleaner" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                    </StackPanel>

                    <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding NavItems}"
                             SelectedItem="{Binding SelectedNav, Mode=TwoWay}" ItemContainerStyle="{StaticResource NavItemStyle}"
                             Margin="12,4" ScrollViewer.VerticalScrollBarVisibility="Auto" Focusable="False">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,0,6,0"/>
                                    <Border Grid.Column="2" Style="{StaticResource Badge}" VerticalAlignment="Center"
                                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding BadgeText}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" VerticalAlignment="Top" Margin="12,0,12,64" Padding="14,12" CornerRadius="12"
                            Background="{DynamicResource CardGradientBrush}" BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1"
                            Visibility="{Binding IsSidebarCollapsed, Converter={StaticResource BoolToVis}, ConverterParameter=invert}">
                        <StackPanel>
                            <TextBlock Text="{Binding DiskTitle}" Style="{StaticResource TextCaption}"/>
                            <TextBlock Text="{Binding DiskDetail}" FontWeight="SemiBold" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                            <ProgressBar Style="{StaticResource ModernProgress}" Height="5" m:Motion.AnimatedValue="{Binding DiskFraction}"/>
                        </StackPanel>
                    </Border>

                    <Button Grid.Row="2" VerticalAlignment="Bottom" Style="{StaticResource GhostButton}" Command="{Binding ToggleSidebarCommand}" Margin="12,0,12,14"
                            HorizontalContentAlignment="Left" Padding="0" Height="40" ToolTip="{loc:T MainToggleSidebarTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE700;" Style="{StaticResource IconText}" Width="48"/>
                            <TextBlock Text="{loc:T MainCollapseSidebar}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- ============ Основная область ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Шапка (область перетаскивания окна) -->
                <Grid Grid.Row="0" Margin="28,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <ctl:TransitioningContentControl Content="{Binding Status.DisplayState}" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                      Offset="6" IsTabStop="False">
                        <ctl:TransitioningContentControl.ContentTemplate>
                            <DataTemplate>
                                <Border CornerRadius="16" Padding="12,6" Background="{Binding Converter={StaticResource StateBrush}, ConverterParameter=soft}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Converter={StaticResource StateGlyph}}" Style="{StaticResource IconText}" FontSize="13"
                                                   Foreground="{Binding Converter={StaticResource StateBrush}}"
                                                   m:Motion.SpinWhen="{Binding Converter={StaticResource StateIsBusy}}"/>
                                        <TextBlock Text="{Binding DataContext.Status.DisplayTitle, RelativeSource={RelativeSource AncestorType=Window}}"
                                                   Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                                   Foreground="{Binding Converter={StaticResource StateBrush}}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ctl:TransitioningContentControl.ContentTemplate>
                    </ctl:TransitioningContentControl>

                    <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ScanCommand}" Height="34" Padding="14,0"
                            Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T MainScanTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                       m:Motion.SpinWhen="{Binding Status.IsBusy}"/>
                            <TextBlock Text="{loc:T HomeScan}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Command="{Binding SortAllCommand}" Height="34" Padding="14,0"
                            Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="{loc:T MainSortTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE8CB;" Style="{StaticResource IconText}" FontSize="13" Foreground="White"/>
                            <TextBlock Text="{loc:T MainSort}" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource WindowButton}" Content="&#xE921;" Click="OnMinimize" ToolTip="{loc:T CommonMinimize}"/>
                        <Button x:Name="MaxButton" Style="{StaticResource WindowButton}" Content="&#xE922;" Click="OnMaximize" ToolTip="{loc:T CommonMaximize}"/>
                        <Button Style="{StaticResource WindowButton}" Content="&#xE8BB;" Click="OnClose" ToolTip="{loc:T CommonClose}"/>
                    </StackPanel>
                </Grid>

                <!-- Полоса состояния операции -->
                <Border Grid.Row="1" Height="0" ClipToBounds="True"
                        m:Motion.AnimatedHeight="{Binding Status.BannerVisible, Converter={StaticResource BoolToDouble}, ConverterParameter=76|0}">
                    <Border Margin="28,4,28,10" Height="62" CornerRadius="14" Background="{DynamicResource BgCardBrush}"
                            BorderBrush="{DynamicResource StrokeBrush}" BorderThickness="1" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5"/>
                                <ColumnDefinition Width="56"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="{Binding Status.State, Converter={StaticResource StateBrush}}" CornerRadius="14,0,0,14"/>
                            <TextBlock Grid.Column="1" Text="{Binding Status.State, Converter={StaticResource StateGlyph}}" Style="{StaticResource IconText}"
                                       FontSize="20" Foreground="{Binding Status.State, Converter={StaticResource StateBrush}}"
                                       m:Motion.SpinWhen="{Binding Status.IsBusy}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Status.Title}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                                    <ctl:AnimatedNumber Value="{Binding Status.LiveCount}" FontWeight="SemiBold" FontSize="14" Margin="10,0,0,0"
                                                        Foreground="{DynamicResource AccentBlueBrush}"
                                                        Visibility="{Binding Status.IsIndeterminate, Converter={StaticResource BoolToVis}}"/>
                                    <TextBlock Text="{loc:T MainFilesSeparator}" Style="{StaticResource TextCaption}" VerticalAlignment="Bottom" Margin="4,0,0,2"
                                               Visibility="{Binding Status.IsIndeterminate, Converter={StaticResource BoolToVis}}"/>
                                    <ctl:AnimatedNumber Value="{Binding Status.LiveBytes}" Format="Bytes" FontSize="14" FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"
                                                        Visibility="{Binding Status.IsIndeterminate, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding Status.Detail}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                <ProgressBar Style="{StaticResource ModernProgress}" Height="4" Margin="0,7,0,0"
                                             IsIndeterminate="{Binding Status.IsIndeterminate}" m:Motion.AnimatedValue="{Binding Status.Progress}"
                                             Visibility="{Binding Status.IsBusy, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <Button Grid.Column="3" Style="{StaticResource SecondaryButton}" Content="{loc:T CommonCancel}" Command="{Binding Status.CancelCommand}"
                                    Padding="14,6" Margin="0,0,14,0" VerticalAlignment="Center"
                                    Visibility="{Binding Status.IsBusy, Converter={StaticResource BoolToVis}}"/>
                            <Button Grid.Column="4" Style="{StaticResource IconButton}" Content="&#xE711;" Command="{Binding Status.DismissBannerCommand}"
                                    Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{loc:T MainHide}"
                                    Visibility="{Binding Status.IsBusy, Converter={StaticResource BoolToVis}, ConverterParameter=invert}"/>
                        </Grid>
                    </Border>
                </Border>

                <!-- Текущая страница -->
                <ctl:TransitioningContentControl Grid.Row="2" Content="{Binding CurrentPage}" IsTabStop="False"
                                                  HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
            </Grid>
        </Grid>

        <!-- ============ Диалоги ============ -->
        <Grid Visibility="{Binding Dialogs.Current, Converter={StaticResource NullToVis}}">
            <Border Background="{DynamicResource ScrimBrush}" m:Motion.Entrance="Fade" m:Motion.EntranceRepeat="True"
                    m:Motion.ExitWhen="{Binding Dialogs.Current.IsClosing, FallbackValue=False}"/>
            <ContentControl Content="{Binding Dialogs.Current}" HorizontalAlignment="Center" VerticalAlignment="Center" Focusable="False"
                            Margin="24" IsTabStop="False"
                            m:Motion.Entrance="Pop" m:Motion.EntranceRepeat="True"
                            m:Motion.ExitWhen="{Binding Dialogs.Current.IsClosing, FallbackValue=False}" m:Motion.ExitKind="Pop"/>
        </Grid>

        <!-- ============ Уведомления ============ -->
        <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="392"
                      Margin="0,0,24,24" Focusable="False" IsTabStop="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type svc:ToastViewModel}">
                    <Border Margin="0,8,0,0" CornerRadius="14" Padding="14,12" Background="{DynamicResource BgElevatedBrush}"
                            BorderBrush="{DynamicResource StrokeStrongBrush}" BorderThickness="1"
                            m:Motion.Entrance="FromRight" m:Motion.ExitWhen="{Binding IsClosing}" m:Motion.ExitKind="SlideRight">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.45" Color="{DynamicResource ShadowColor}"/>
                        </Border.Effect>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="34" Height="34" CornerRadius="17" VerticalAlignment="Top"
                                    Background="{Binding Kind, Converter={StaticResource ToastBrush}, ConverterParameter=soft}"
                                    m:Motion.Entrance="Pop" m:Motion.EntranceDelay="140">
                                <TextBlock Text="{Binding Glyph}" Style="{StaticResource IconText}" FontSize="15"
                                           Foreground="{Binding Kind, Converter={StaticResource ToastBrush}}"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,1,8,0">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Message}" Style="{StaticResource TextSecondary}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"
                                           Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}"/>
                                <Button Style="{StaticResource LinkButton}" Content="{Binding ActionText}" Command="{Binding RunActionCommand}"
                                        HorizontalAlignment="Left" Margin="-8,4,0,-4"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE711;" Width="26" Height="26" FontSize="10"
                                    VerticalAlignment="Top" Command="{Binding DismissCommand}" ToolTip="{loc:T CommonClose}"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</Window>
