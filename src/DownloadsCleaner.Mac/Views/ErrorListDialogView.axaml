<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
             xmlns:models="clr-namespace:DownloadsCleaner.Models"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             x:Class="DownloadsCleaner.Mac.Views.ErrorListDialogView">

    <Border Classes="card" Width="600" Padding="24">
        <StackPanel Spacing="14">
            <TextBlock Text="{Binding Title}" Classes="heading" FontSize="18" TextWrapping="Wrap" />

            <Border Background="{DynamicResource BgInputBrush}" CornerRadius="12" Padding="6" MaxHeight="280">
                <ListBox ItemsSource="{Binding Failures}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="models:FailedOperation">
                            <StackPanel Margin="10,6">
                                <TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Reason}" Classes="caption" Foreground="{DynamicResource DangerBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Button Content="{loc:T CommonClose}" Command="{Binding CancelCommand}" Classes="primary" HorizontalAlignment="Right" />
        </StackPanel>
    </Border>
</UserControl>
