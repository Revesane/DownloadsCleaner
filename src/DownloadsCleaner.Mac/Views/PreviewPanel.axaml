<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DownloadsCleaner.ViewModels"
             xmlns:loc="clr-namespace:DownloadsCleaner.Localization"
             x:Class="DownloadsCleaner.Mac.Views.PreviewPanel">

    <Border Classes="card" Padding="14">
        <StackPanel Spacing="10">
            <TextBlock Text="{loc:T FilesPreviewHeader}" Classes="heading" />

            <TextBlock Text="{loc:T PreviewSelectFile}" Classes="caption" TextAlignment="Center"
                       IsVisible="{Binding HasFile, Converter={StaticResource BoolToVis}, ConverterParameter=invert}}" />

            <StackPanel IsVisible="{Binding HasFile, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="10" Background="{DynamicResource BgInputBrush}" Padding="8" Height="260">
                    <Panel>
                        <Image Source="{Binding Image}" Stretch="Uniform"
                               IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Image}" />
                        <ScrollViewer MaxHeight="244"
                                      IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Text}">
                            <TextBlock Text="{Binding Text}" FontFamily="Menlo, Monaco, monospace" FontSize="11"
                                       TextWrapping="NoWrap" />
                        </ScrollViewer>
                        <TextBlock Text="{Binding Message}" Classes="caption" TextWrapping="Wrap" TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding Kind, Converter={StaticResource Equals}, ConverterParameter=Info}" />
                    </Panel>
                </Border>

                <StackPanel Margin="0,10,0,0">
                    <TextBlock Text="{Binding File.Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding InfoLines}" Classes="caption" Margin="0,6,0,0" LineHeight="20" />
                    <TextBlock Text="{Binding File.FullPath}" Classes="caption" Margin="0,6,0,0" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="{loc:T CommonOpen}" Command="{Binding OpenExternalCommand}" Classes="secondary" />
                        <Button Content="{loc:T PreviewInExplorer}" Command="{Binding ShowInExplorerCommand}" Classes="ghost" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
